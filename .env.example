# Root/shared env template — copy to .env for docker-compose local dev.
# Each app also has its own .env.example (apps/web, apps/api, tools/mock-device-simulator).

# --- postgres ---
POSTGRES_USER=smis
POSTGRES_PASSWORD=smis_dev_password
POSTGRES_DB=smis
POSTGRES_PORT=5432

# --- api (apps/api) ---
DATABASE_URL=postgresql://smis:smis_dev_password@postgres:5432/smis
API_PORT=3001
JWT_SECRET=change_me_dev_only
DEVICE_API_KEY=change_me_dev_device_key
TELEGRAM_BOT_TOKEN=

# --- web (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# --- device simulator (tools/mock-device-simulator), only used with --profile simulator ---
SIMULATOR_DEVICE_COUNT=5
SIMULATOR_SEND_INTERVAL_MS=7000
